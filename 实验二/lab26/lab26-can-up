#!/usr/bin/env bash
set -e
details=$(/sbin/ip -details link show can0)
if grep -qw 'bitrate 500000' <<<"$details" && grep -qw 'restart-ms 1000' <<<"$details" && grep -qw LOWER_UP <<<"$details"; then
  exit 0
fi
/sbin/ip link set can0 down
/sbin/ip link set can0 type can bitrate 500000 restart-ms 1000
/sbin/ip link set can0 up
