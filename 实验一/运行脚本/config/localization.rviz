Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 25; 29; 38
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid 1 metre
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz/PointCloud2
      Name: Dense saved map
      Enabled: true
      Topic: /lab1_dense_map
      Queue Size: 1
      Size (Pixels): 2
      Style: Points
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Decay Time: 0
      Alpha: 1
    - Class: rviz/Path
      Name: Global localization trajectory
      Enabled: true
      Topic: /corrected_path
      Color: 40; 230; 255
      Alpha: 1
      Buffer Length: 1
    - Class: rviz/Pose
      Name: Accepted global pose
      Enabled: true
      Topic: /pose_stamped
      Color: 255; 100; 30
      Shape: Arrow
      Alpha: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 14
      Pitch: 0.9
      Yaw: 1
      Target Frame: map
      Focal Point: {X: 0, Y: 0, Z: 0}
Window Geometry: {Width: 1820, Height: 970, X: 65, Y: 30}
