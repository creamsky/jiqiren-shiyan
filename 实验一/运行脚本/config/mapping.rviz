Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 25; 29; 38
    Fixed Frame: camera_init
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid 1 metre
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz/PointCloud2
      Name: Live mapping cloud
      Enabled: true
      Topic: /cloud_registered
      Queue Size: 2
      Size (Pixels): 2
      Style: Points
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Decay Time: 30
      Alpha: 0.6
    - Class: rviz/Path
      Name: Mapping trajectory
      Enabled: true
      Topic: /path
      Color: 40; 230; 255
      Alpha: 1
      Buffer Length: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 14
      Pitch: 0.9
      Yaw: 1
      Target Frame: body
      Focal Point: {X: 0, Y: 0, Z: 0}
Window Geometry: {Width: 1820, Height: 970, X: 65, Y: 30}
