<launch>
  <arg name="map_bag" />
  <arg name="map_pcd" />
  <arg name="rviz" default="true" />
  <include file="$(find fast_lio)/launch/mapping_velodyne.launch">
    <arg name="rviz" value="$(arg rviz)" />
  </include>
  <param name="/pcd_save/file_path" value="$(arg map_pcd)" />
  <param name="/pcd_save/pcd_save_en" value="true" type="bool" />
  <node pkg="fast_lio_localization_qn" type="record_keyframe_map.py"
        name="keyframe_map_recorder" output="screen" required="true">
    <param name="output_bag" value="$(arg map_bag)" />
    <param name="keyframe_distance" value="1.5" />
    <param name="keyframe_angle_deg" value="15.0" />
  </node>
</launch>
